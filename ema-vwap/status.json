{"schema":2,"updated_at":"2026-10-30T22:14:18+00:00","strategy":{"id":"ema-vwap","name":"EMA + VWAP Trend","description":"A trend-following strategy. When a stock is trending (price on the right side of the day's VWAP and a fast moving average pulled away from a slow one), the bot waits for the first dip against the trend, buys it in an uptrend or sells it in a downtrend, and rides the move with a stop beyond the dip. It is the opposite of RSI Reversion: that one bets on snap-backs, this one bets that strong moves keep going. The whole account goes into one position at a time and everything is closed before the market closes.","kind":"intraday","timeframe":"1-minute entries, 5-minute trend","schedule":"Checks every minute. Enters between 9:40 AM and 11:30 AM ET and after 1:30 PM ET, never in the last 40 minutes, and closes everything 10 minutes before the close.","rules":["Uptrend: price above the day's VWAP, the 9-period average above the 21-period average (5-minute candles), and the 21-period average rising. Downtrend is the mirror image.","Pullback: within the last 8 minutes price dipped to the 9-period average without breaking well below the 21-period one.","Trigger: the latest 1-minute bar turns back with the trend and closes beyond the previous bar's high (long) or low (short).","The stop goes just beyond the dip. Take-profit at 2 times the risk, or the trade ends at the close.","The whole account goes into one position at a time. If several stocks set up together, the strongest trend is taken."],"params":[{"key":"fast_ema","label":"Fast average","display":"9 candles","hint":"5-minute candles"},{"key":"slow_ema","label":"Slow average","display":"21 candles","hint":"5-minute candles"},{"key":"pullback_bars","label":"Pullback window","display":"8 min","hint":"How far back the dip may have happened"},{"key":"min_trend_gap_pct","label":"Smallest trend gap","display":"0.03%","hint":"How far apart the two averages must be to call it a trend"},{"key":"target_r","label":"Take-profit","display":"2x the risk","hint":"Distance of the profit target, as a multiple of the stop distance"},{"key":"risk_per_trade_pct","label":"Risk per trade","display":"0.50%","hint":"Share of the account lost if the stop-loss is hit. The bot never goes above 2%"}],"indicators":[{"key":"vs_vwap_pct","label":"Price vs VWAP (%)","decimals":2,"range":[-1,1],"zone":"outside","marks":[{"value":-0.05,"label":"Down"},{"value":0.05,"label":"Up"}]},{"key":"ema_gap_pct","label":"EMA 9 vs EMA 21 (%)","decimals":3,"range":[-0.3,0.3],"zone":"outside","marks":[{"value":-0.03,"label":"Down"},{"value":0.03,"label":"Up"}]},{"key":"trend_stage","label":"Setup progress (0 to 3)","decimals":0,"range":[0,3],"zone":"above","marks":[{"value":2.5,"label":"Entry"}]}],"symbols":["AAPL","MSFT","SPY","QQQ","NVDA","TSLA","AMD","PLTR"],"configured":true,"settings":[{"label":"Max daily loss","display":"3.0%","hint":"New trades stop for the day if the account falls this far"},{"label":"Costs on the dashboard","display":"Estimated","hint":"Closed trades also show a result after estimated slippage and fees, because paper fills are cleaner than real ones"},{"label":"Check interval","display":"60 sec","hint":"How often the bot looks at the market"},{"label":"Risk per trade","display":"0.50% of the account","hint":"What the account loses if the stop-loss is hit. The bot never risks more than 2%"},{"label":"Position size","display":"Up to 95% of the account, one at a time","hint":"The whole account goes into one position. A close stop gets the full size; a wide stop gets a smaller one"},{"label":"Longest hold","display":"Until the target, the stop, or the close","hint":"Every position is closed before the market closes"},{"label":"Closes everything","display":"10 min before the close","hint":"No positions are held overnight"},{"label":"Pause after losses","display":"3 losing trades in a row","hint":"No new trades for the rest of the day"},{"label":"Entry order","display":"Limit order just past the price","hint":"A limit order a few hundredths of a percent beyond the last price. It is cancelled if it has not filled within 90 seconds, so the bot never chases a fast move"}]},"bot":{"state":"stopped","message":"The market is closed. The next scheduled run starts before the open.","started_at":"2026-10-30T22:14:17+00:00","passes":0,"last_pass_at":null,"errors_in_row":0,"last_error":null,"last_error_at":null,"run_url":"https://github.com/greysonbrindley727-wq/Trading-bot-V6/actions/runs/41136720179","version":"8.0.0"},"market":{"is_open":false,"next_open":"2026-11-02T09:30:00-05:00","next_close":"2026-11-02T16:00:00-05:00"},"account":{"equity":4947.39,"last_equity":4960.27,"day_pnl":-12.88000000000011,"day_pnl_pct":-0.2596632844583079,"cash":4947.39,"buying_power":19789.56,"status":"ACTIVE","starting_equity":5000.0,"tracking_since":"2026-10-21T03:16:40+00:00"},"positions":[],"open_orders":[],"recent_orders":[{"id":"c3d2211d-4d2c-41cf-a496-84e946d434a0","symbol":"AAPL","side":"buy","qty":13.0,"filled_qty":13.0,"type":"stop","order_class":"bracket","status":"filled","limit_price":null,"stop_price":343.68,"filled_avg_price":343.69,"submitted_at":"2026-10-30T19:27:16.193343+00:00","filled_at":"2026-10-30T19:27:17.917259+00:00"},{"id":"a63e566e-5763-4342-bf24-a1ffae71580f","symbol":"AAPL","side":"buy","qty":13.0,"filled_qty":0.0,"type":"limit","order_class":"bracket","status":"canceled","limit_price":342.21,"stop_price":null,"filled_avg_price":null,"submitted_at":"2026-10-30T19:12:56.759157+00:00","filled_at":null},{"id":"93ad1cd4-ab3c-4c29-bf0c-dc96231cc08e","symbol":"AAPL","side":"sell","qty":13.0,"filled_qty":13.0,"type":"limit","order_class":"bracket","status":"filled","limit_price":343.02,"stop_price":null,"filled_avg_price":343.193077,"submitted_at":"2026-10-30T19:12:53.737769+00:00","filled_at":"2026-10-30T19:12:56.733228+00:00"},{"id":"924369a7-cfdd-40a3-ad4f-7e0806424a94","symbol":"MSFT","side":"buy","qty":9.0,"filled_qty":9.0,"type":"stop","order_class"