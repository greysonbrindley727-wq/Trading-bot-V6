{"schema":2,"updated_at":"2026-10-30T22:14:18+00:00","strategy":{"id":"tjr-sweep","name":"TJR Liquidity Sweep","description":"A rule-based version of the popular liquidity sweep and fair value gap style. Traders say stop-losses pile up just beyond obvious highs and lows, and that price often runs those levels and then reverses. The bot waits for price to run the previous day's high or low (or a high or low from earlier today) and snap back, for the 5-minute chart to shift structure the other way, and for price to pull back into a gap on the 1-minute chart. Then it trades in the new direction with the stop beyond the sweep. The whole account goes into one position at a time, and each trade is closed within the hour. This is an automated approximation of a style that is normally traded by eye, so the results say whether this version works, not the whole idea.","kind":"intraday","timeframe":"1-minute entries, 5-minute structure","schedule":"Checks every minute. Enters between 9:40 AM and 11:30 AM ET and after 1:30 PM ET, never in the last 40 minutes, and closes everything 10 minutes before the close.","rules":["Sweep: price runs past the previous day's high or low, or a high or low from earlier today, then closes back inside within a few minutes.","Structure shift: a finished 5-minute candle closes beyond the recent swing, in the opposite direction of the sweep.","Fair value gap: on the 1-minute chart, a three-bar gap forms after the sweep. The bot enters when price comes back into it.","Sweep of a low means long, sweep of a high means short. The stop goes just beyond the sweep.","Take-profit at 2 times the risk. Closed after 60 minutes at most, and before the market closes.","The whole account goes into one position at a time. If several stocks set up together, the cleanest setup is taken."],"params":[{"key":"setup_max_age","label":"Sweep must be within","display":"45 min","hint":"How recent the sweep has to be"},{"key":"min_sweep_pct","label":"Smallest sweep","display":"0.02%","hint":"How far past the level price has to poke"},{"key":"min_fvg_pct","label":"Smallest gap","display":"0.03%","hint":"Size of the fair value gap, as a share of the price"},{"key":"target_r","label":"Take-profit","display":"2x the risk","hint":"Distance of the profit target, as a multiple of the stop distance"},{"key":"max_hold_minutes","label":"Longest hold","display":"60 min","hint":"A trade is closed after this long"},{"key":"risk_per_trade_pct","label":"Risk per trade","display":"0.50%","hint":"Share of the account lost if the stop-loss is hit. The bot never goes above 2%"}],"indicators":[{"key":"stage","label":"Setup progress (0 to 4)","decimals":0,"range":[0,4],"zone":"above","marks":[{"value":3.5,"label":"Entry"}]}],"symbols":["AAPL","MSFT","SPY","QQQ","NVDA","TSLA","AMD","PLTR"],"configured":true,"settings":[{"label":"Max daily loss","display":"3.0%","hint":"New trades stop for the day if the account falls this far"},{"label":"Costs on the dashboard","display":"Estimated","hint":"Closed trades also show a result after estimated slippage and fees, because paper fills are cleaner than real ones"},{"label":"Check interval","display":"60 sec","hint":"How often the bot looks at the market"},{"label":"Risk per trade","display":"0.50% of the account","hint":"What the account loses if the stop-loss is hit. The bot never risks more than 2%"},{"label":"Position size","display":"Up to 95% of the account, one at a time","hint":"The whole account goes into one position. A close stop gets the full size; a wide stop gets a smaller one"},{"label":"Longest hold","display":"60 min","hint":"Every position is closed before the market closes"},{"label":"Closes everything","display":"10 min before the close","hint":"No positions are held overnight"},{"label":"Pause after losses","display":"3 losing trades in a row","hint":"No new trades for the rest of the day"},{"label":"Entry order","display":"Limit order just past the price","hint":"A limit order a few hundredths of a percent beyond the last price. It is cancelled if it has not filled within 90 seconds, so the bot never chases a fast move"}]},"bot":{"state":"stopped","message":"The market is closed. The next scheduled run starts before the open.","started_at":"2026-10-30T22:14:17+00:00","passes":0,"last_pass_at":null,"errors_in_row":0,"last_error":null,"last_error_at":null,"run_url":"https://github.com/greysonbrindley727-wq/Trading-bot-V6/actions/runs/41136720179","version":"8.0.0"},"market":{"is_open":false,"next_open":"2026-11-02T09:30:00-05:00","next_close":"2026-11-02T16:00:00-05:00"},"account":{"equity":4982.39,"last_equity":4974.1,"day_pnl":8.289999999999964,"day_pnl_pct":0.16666331597675887,"cash":4982.39,"buying_power":19929.56,"status":"ACTIVE","starting_equity":5000.0,"tracking_since":"2026-10-21T03:16:40+00:00"},"positions":[],"open_orders":[],"recent_orders":[{"id":"be6d89cf-daff-4147-a439-937295320088","symbol":"QQQ","side":"sell","qty":6.0,"filled_qty":6.0,"type":"limit","order_class":"bracket","status":"filled","limit_price":688.45,"stop_price":null,"filled_avg_price":688.471667,"submitted_at":"2026-10-30T19:01:55.042067+00:00","filled_at":"2026-10-30T19:45:41.828000+00:00"},{"id":"8d21fbab-e03f-450d-8281-d86cc27df4ad","symbol":"QQQ","side":"buy","qty":6.0,"filled_qty":6.0,"type":"limit","order_class":"bracket","status":"filled","limit_price":685.38,"stop_price":null,"filled_avg_price":685.125,"submitted_at":"2026-10-30T19:01:52.832092+00:00","filled_at":"2026-10-30T19:01:55.033055+00:00"},{"id":"d58cc973-310c-476e-ae5e-48616c78e232","symbol":"QQQ","side":"sell","qty":6.0,"filled_qty":0.0,"type":"stop","order_class":"bracket","status":"canceled","limit_price":null,"stop_price":683.33,"filled_avg_price":null,"submitted_at":"2026-10-30T19:01:52.827314+00:00","filled_at":null},{"id":"acc6ba9b-01cf-4d3e-9cc1-c482756943f0","symbol":"MSFT","side":"sell","qty":9.0,"filled_qty":9.0,"type":"stop","order_class":"bracket","status":"filled","limit_price":null,"stop_price"